# Discord Developer Portal → https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# Supabase → Project Settings → API Keys. Must be the SECRET / service_role key (not anon/publishable).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Long random string used to sign login cookies (Render generates it automatically)
SESSION_SECRET=change_me_to_a_long_random_string

# Optional: public site URL. On Render it is detected automatically (RENDER_EXTERNAL_URL).
# PUBLIC_URL=https://lg-economy.onrender.com

# Payout schedule (18:30) uses this time zone
TZ=Europe/Moscow
